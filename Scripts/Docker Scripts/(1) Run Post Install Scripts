export TRUSTED_IPS=""      # admin hosts you SSH in from, never banned (space-separated)
export SSH_ALLOW_CIDR=""   # the only network SSH accepts logins from (e.g. 192.168.1.0/24)
export SSH_DENY_ADDRS=""   # hosts in that network that must not log in (comma-separated), or none

